# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

DUBBER_REGION=us
DUBBER_ACCOUNT_ID=
DUBBER_AUTH_ID=
DUBBER_AUTH_TOKEN=
DUBBER_CLIENT_ID=
DUBBER_CLIENT_SECRET=

PORT=3000

# Shift window (24h). Used to compute breaks.
SHIFT_START=09:00
SHIFT_END=18:00
SHIFT_TIMEZONE=Asia/Kolkata

# A continuous gap of at least this many minutes during the shift counts as a break.
BREAK_GAP_MINUTES=15
